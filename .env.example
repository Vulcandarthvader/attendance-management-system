# Copy to server/.env and edit. Never commit the real file.
#
# Every value here is optional: with none of them set the API starts on port
# 5000 using in-memory storage and seeds a demo account, which is what makes
# `npm run dev` work on a clean machine.

# --- storage -----------------------------------------------------------------
# Leave blank to run in memory (data is discarded when the server stops).
# Set it to persist:
#   local   mongodb://127.0.0.1:27017/attendance
#   Atlas   mongodb+srv://<user>:<password>@<cluster>/attendance
MONGO_URI=

# --- server ------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# --- auth --------------------------------------------------------------------
# Required in production; generated per process in development.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- demo data ---------------------------------------------------------------
# auto = seed only when the database has no users. Use false for real data.
SEED_DEMO=auto
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
