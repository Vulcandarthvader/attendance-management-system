# Copy this file to ".env" (same folder) and fill in the values.
# Never commit the real .env file to GitHub.

# Local MongoDB:  mongodb://127.0.0.1:27017/attendance
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/attendance
MONGO_URI=mongodb://127.0.0.1:27017/attendance

# Any long random string. Used to sign login tokens (JWT).
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000
